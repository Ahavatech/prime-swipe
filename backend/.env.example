NODE_ENV=development
PORT=8080
DATABASE_PATH=./data/prime-swipe-dev.db
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SUBMIT_RATE_LIMIT_MAX=20
# Leave empty in development for a throwaway secret. Production must set one (32+ characters).
RUN_TOKEN_SECRET=
RUN_TOKEN_TTL_SECONDS=21600
TRUST_PROXY_HOPS=0
